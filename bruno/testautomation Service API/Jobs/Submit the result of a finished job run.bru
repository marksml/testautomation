meta {
  name: Submit the result of a finished job run
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/jobs/:jobRunId/result
  body: json
  auth: inherit
}

params:path {
  jobRunId: 
}

body:json {
  {
    "status": "",
    "startedAt": "",
    "finishedAt": "",
    "durationMs": 0,
    "message": "",
    "stackTrace": "",
    "artifacts": [
      {
        "name": "",
        "mediaType": "",
        "sizeBytes": 0,
        "uri": "",
        "sha256": ""
      }
    ]
  }
}

example {
  name: 200 Response
  description: Result accepted (or already recorded with the same status).
  
  request: {
    url: {{baseUrl}}/api/v1/jobs/:jobRunId/result
