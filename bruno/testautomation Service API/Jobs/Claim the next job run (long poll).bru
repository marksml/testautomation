example {
  name: 409 Response
  description: The agent may not claim (unknown/unregistered, or at its job limit).
  
  request: {
    url: {{baseUrl}}/api/v1/jobs/claim
    method: POST
    mode: json
    params:query: {
      ~wait: 
    }
  
    body:json: {
      {
        "agentId": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "status": 0,
          "code": "",
          "message": "",
          "details": {}
        }
      '''
    }
  }
}
