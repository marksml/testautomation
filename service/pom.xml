<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.mmar.testautomation</groupId>
        <artifactId>testautomation-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>testautomation-service</artifactId>
    <name>testautomation-service</name>
    <description>Spring Boot service that distributes test case execution to test agents</description>

    <properties>
        <!-- Spring Boot's BOM does not manage swagger-core (that is springdoc's job) and the
             generated API interfaces are annotated with io.swagger.v3.oas.annotations.*.
             Version derived from: openapi-generator 7.19.0 / swagger-core 2.2.x line. -->
        <swagger-annotations-jakarta.version>2.2.55</swagger-annotations-jakarta.version>
        <openapi-generator.version>7.19.0</openapi-generator.version>

        <!-- Spring Boot's BOM does not manage springdoc either (only springdoc does it for
             swagger-core). 3.1.1 is the Spring Boot 4 line: its parent is
             spring-boot-starter-parent 4.1.0 (this project is on 4.1.1) and it pins
             swagger-api 2.2.55, the same swagger-core version as the property above, so the two
             do not disagree. -->
        <springdoc.version>3.1.1</springdoc.version>

    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- REST layer: the generated @RestController classes are picked up by component scan. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean validation for the generated @Valid request bodies and path variables. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Annotations used by the generated api/ and model/ sources (io.swagger.v3.oas.annotations). -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>${swagger-annotations-jakarta.version}</version>
        </dependency>

        <!-- Swagger UI (/swagger-ui.html) plus the document behind it (/v3/api-docs), rendered at
             runtime by springdoc from the annotations the build puts on the generated API
             interfaces and models. Those carry @Tag, @Operation (summary + description),
             @Parameter and @ApiResponse with the text from openapi/testautomation-service.yaml, so
             the UI shows the contract itself and the YAML stays the single source of truth — there
             is no second, hand-maintained description of the API. Nothing to wire up: springdoc's
             autoconfiguration scans the generated @Controller classes.

             Adding this does NOT expose Spring Boot Actuator: springdoc's transitive
             spring-boot-actuator-autoconfigure is optional, so it never reaches the classpath. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver. Runtime scope on purpose: the hand-written repository only
             touches javax.sql.DataSource, so nothing in main/ or test/ compiles against driver
             classes — but Maven's test classpath includes runtime scope, so the integration tests
             reach the driver through DriverManager without a compile-time dependency. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testcontainers: the integration tests (*IT) start their own PostgreSQL 16 when a Docker
             daemon is available, and fall back to an external database when one is configured
             (docs/test-execution.md). No <version> here on purpose: spring-boot-dependencies 4.1.1
             imports testcontainers-bom 2.0.5, the current release line.

             Testcontainers 2 renamed the module artifacts (`postgresql` ->
             `testcontainers-postgresql`, `junit-jupiter` -> `testcontainers-junit-jupiter`) and moved
             the container classes into per-module packages
             (`org.testcontainers.containers.PostgreSQLContainer` ->
             `org.testcontainers.postgresql.PostgreSQLContainer`, now a raw type without the
             self-referencing generic). Never mix 1.x and 2.x artifacts or imports on the classpath:
             that fails at runtime with ClassNotFoundException.

             The 1.x line cannot talk to a current Docker Engine: it bundles docker-java 3.4.2, which
             falls back to Docker API 1.32, and Docker 29+ rejects anything below 1.40 with
             `400 client version 1.32 is too old. Minimum supported API version is 1.40`. 2.0.5
             bundles docker-java 3.7.1, which negotiates the API version with the daemon. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <!--
                Generates the REST layer from openapi/testautomation-service.yaml.

                Output goes to target/generated-sources/openapi (added to the compile source root
                by the plugin) — nothing is written into src/main/java, so hand-written code,
                above all the *ApiDelegate implementations, can never be overwritten by a build.

                delegatePattern=true produces, per tag in the spec:
                  api/<Tag>Api.java          interface: paths, @RequestMapping, @Validated, delegates
                  api/<Tag>ApiController.java @RestController wiring the delegate bean (generated)
                  api/<Tag>ApiDelegate.java   interface to implement by hand in src/main/java
            -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-service-api</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../openapi/testautomation-service.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <!-- Keeps the generator's sample application (extra main class,
                                 application.properties) out of the output; see the file itself. -->
                            <ignoreFileOverride>${project.basedir}/../openapi/.openapi-generator-ignore</ignoreFileOverride>
                            <apiPackage>ch.mmar.testautomation.service.api</apiPackage>
                            <modelPackage>ch.mmar.testautomation.service.model</modelPackage>
                            <invokerPackage>ch.mmar.testautomation.service.invoker</invokerPackage>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <configOptions>
                                <!-- Hand-written delegates instead of generated @RestController bodies. -->
                                <delegatePattern>true</delegatePattern>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                                <useTags>true</useTags>
                                <useResponseEntity>true</useResponseEntity>
                                <useBeanValidation>true</useBeanValidation>
                                <performBeanValidation>true</performBeanValidation>
                                <!-- Keep @RequestMapping on the API interface, not on the controller. -->
                                <requestMappingMode>api_interface</requestMappingMode>
                                <!-- swagger2 = the io.swagger.v3.oas.annotations library. -->
                                <annotationLibrary>swagger2</annotationLibrary>
                                <documentationProvider>none</documentationProvider>
                                <!-- Avoids the extra org.openapitools:jackson-databind-nullable dependency. -->
                                <openApiNullable>false</openApiNullable>
                                <dateLibrary>java8</dateLibrary>
                                <skipDefaultInterface>false</skipDefaultInterface>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                Unit tests only. Integration tests are named *IT and belong to failsafe below, so
                `mvn test` never needs a database — note that surefire's default include pattern
                (`**/Test*.java`) would otherwise pick up names like TestcontainersPostgresIT.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
                Integration tests: *IT runs in the `verify` phase, so `./mvnw verify` is the single
                command that runs everything — unit tests (surefire) and the tests that need a real
                PostgreSQL (failsafe). *IT, not *Test, is what keeps a database requirement out of
                `mvn test`.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
