meta {
  name: Renew the lease of a running job run (heartbeat)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/v1/jobs/:jobRunId/lease
  body: none
  auth: inherit
}

params:path {
  jobRunId: 
}

example {
  name: 200 Response
  description: Lease renewed.
  
  request: {
    url: {{baseUrl}}/api/v1/jobs/:jobRunId/lease
    method: PUT
    mode: none
    params:path: {
      jobRunId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "jobRunId": "",
          "leaseExpiresAt": "",
          "heartbeatIntervalSeconds": 0
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Missing or invalid credentials for this role.
  
  request: {
    url: {{baseUrl}}/api/v1/jobs/:jobRunId/lease
    method: PUT
    mode: none
    params:path: {
      jobRunId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "status": 0,
          "code": "",
          "message": "",
          "details": {}
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: No run with this identifier.
  
  request: {
    url: {{baseUrl}}/api/v1/jobs/:jobRunId/lease
    method: PUT
    mode: none
    params:path: {
      jobRunId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "status": 0,
          "code": "",
          "message": "",
          "details": {}
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: Lease lost (`LEASE_LOST`) or run already terminal (`ALREADY_TERMINAL`).
  
  request: {
    url: {{baseUrl}}/api/v1/jobs/:jobRunId/lease
    method: PUT
    mode: none
    params:path: {
      jobRunId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "status": 0,
          "code": "",
          "message": "",
          "details": {}
        }
      '''
    }
  }
}
