meta {
  name: Read one agent
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/agents/:agentId
  body: none
  auth: inherit
}

params:path {
  agentId: 
}

example {
  name: 200 Response
  description: The agent.
  
  request: {
    url: {{baseUrl}}/api/v1/agents/:agentId
    method: GET
    mode: none
    params:path: {
      agentId: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "agentId": "",
          "name": "",
          "capabilities": [],
          "labels": {},
          "maxJobs": 0,
          "version": "",
          "status": "",
          "registeredAt": "",
          "lastSeenAt": "",
          "activeRuns": 0
        }
      '''
    }
  }
}

